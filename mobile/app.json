{
  "expo": {
    "name": "ViaAlerta",
    "slug": "viaalerta-android",
    "scheme": "viaalerta",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android", "web"],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.viaalerta.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#247D61"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha uma fotografia para registrar uma ocorrência.",
          "cameraPermission": "Use a câmera para fotografar um buraco com segurança.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Confirme o local da ocorrência. Sua localização não é acompanhada em segundo plano."
        }
      ]
    ]
  }
}
