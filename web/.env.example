# Sem estes valores: login real indisponível, demonstração continua funcional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade opcional com a chave pública antiga (anon).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endpoint completo HTTPS que aceita POST multipart, campo "file".
# Vazio = detecção simulada e persistência exclusivamente local.
NEXT_PUBLIC_DETECTION_API_URL=
# Cidade usada somente quando não há registros nem localização já permitida.
NEXT_PUBLIC_DEFAULT_CITY_NAME=Uberlândia, MG
NEXT_PUBLIC_DEFAULT_CITY_LATITUDE=-18.9186
NEXT_PUBLIC_DEFAULT_CITY_LONGITUDE=-48.2772
